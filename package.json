{
  "name": "rubayet-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev -H 127.0.0.1 -p 3000",
    "dev:turbo": "WATCHPACK_POLLING=true next dev -H 127.0.0.1 -p 3000 --turbo",
    "dev:clean": "npm run clean && npm run dev",
    "clean": "rm -rf .next",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:performance": "node scripts/performance.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "next": "^15.5.27",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.15",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module",
  "overrides": {
    "postcss": "8.5.28"
  }
}
